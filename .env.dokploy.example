# =============================================================================
# AutomaLead Community — Dokploy / Docker Compose
# =============================================================================
# Copie para .env e altere os segredos antes do deploy:
#   cp .env.dokploy.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATORIO ALTERAR NO INICIO (DOKPLOY)
# -----------------------------------------------------------------------------
# Use dominios publicos reais do seu projeto no Dokploy.
# Exemplo:
#   BACKEND_URL=https://api.seudominio.com
#   FRONTEND_URL=https://app.seudominio.com
#   CORS_ORIGINS=https://app.seudominio.com,https://api.seudominio.com
# Essas URLs devem ser reais em produção (não use localhost no Dokploy).
BACKEND_URL=https://api.seudominio.com
FRONTEND_URL=https://app.seudominio.com
CORS_ORIGINS=https://app.seudominio.com,https://api.seudominio.com

# EvoFlow (Journeys/Campanhas builder no frontend). O browser chama o
# evo-flow DIRETO (CORS aberto, prefixo /api/v1 próprio) — não passa pelo
# evo-gateway/BACKEND_URL. Precisa de um dominio publico proprio no Dokploy
# apontando pro serviço evo-flow (porta 3334); sem isso o placeholder de build
# (VITE_EVOFLOW_API_URL_PLACEHOLDER) fica sem substituir e as chamadas de
# journeys quebram com 404/405 (EVO-1906).
VITE_EVOFLOW_API_URL=https://flow.seudominio.com

# Segredos criticos (obrigatorio alterar — gere um valor unico para cada)
# SECRET_KEY_BASE / JWT_SECRET_KEY / DOORKEEPER_JWT_SECRET_KEY / ENCRYPTION_KEY:
#   openssl rand -base64 32
# EVOAI_CRM_API_TOKEN / BOT_RUNTIME_SECRET / AUTH_APIKEY_INTEGRATION_LOCAL:
#   openssl rand -base64 32
POSTGRES_PASSWORD=2de34b19f04690469376dfd97f483fb6
REDIS_PASSWORD=6989ad2524e7a79c67ce462757cd9a48
SECRET_KEY_BASE=8jwx+d6lyYikerxrmNUDIpOAbsz67odBmJFPyMRaoy0=
JWT_SECRET_KEY=Mf7JXTlS6fQX7pel6dW3ltyor1sJKyWDbHs7l7MYa5U=
DOORKEEPER_JWT_SECRET_KEY=ty35IYqJm6dAycfyC5+FD9QU68D2Egx1GfAWp4wYBcE=
EVOAI_CRM_API_TOKEN=nRSIRmnoCFbIuvjX/mbBq2RI/pLEU9CGFhHYR9xzaHU=
ENCRYPTION_KEY=yo70i9LVjVTwCnoz6gLyeJIJDJQLSu_n9czpXGXDfz4=
# Same Fernet value as ENCRYPTION_KEY above — feeds the CRM's AI credential vault.
EVO_AI_ENCRYPTION_KEY=yo70i9LVjVTwCnoz6gLyeJIJDJQLSu_n9czpXGXDfz4=
BOT_RUNTIME_SECRET=HWaYuNen/gMCHGwp+I2jNghXXZJHmgEYStJH0RgebTg=

# EvoFlow (journeys/campanhas — segments + tracking de eventos do contato).
# AUTH_APIKEY_INTEGRATION_LOCAL: chave compartilhada entre evo-crm e evo-flow.
#   openssl rand -hex 32
# CLICKHOUSE_PASSWORD / RABBITMQ_PASSWORD: senhas dos bancos internos do EvoFlow.
#   openssl rand -hex 16
AUTH_APIKEY_INTEGRATION_LOCAL=0091e35bcc611b2ebbdef7eca69988bab7904ef1a650a4195dea19bca475acac
CLICKHOUSE_PASSWORD=26b4250503e0604b56696973f30614f3
RABBITMQ_PASSWORD=23b69cefa14e2e2b538cd938dfdffcb9

# -----------------------------------------------------------------------------
# OPCIONAIS (PODE MANTER PADRAO NA PRIMEIRA SUBIDA)
# -----------------------------------------------------------------------------
# Nota: evo-gateway (porta 3030) e evo-frontend (porta 80) usam `expose` no
# compose, não `ports` — sem bind de porta no host. Configure o dominio de
# cada um na UI do Dokploy (Domains), apontando para a porta do container.

# Banco
POSTGRES_DATABASE=evo_community
POSTGRES_USERNAME=postgres

# Ambiente Rails
RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# Auth service
MAILER_SENDER_EMAIL=noreply@evo.local
DOORKEEPER_JWT_ALGORITHM=hs256
DOORKEEPER_JWT_ISS=evo-auth-service
MFA_ISSUER=EvoCRM
SIDEKIQ_CONCURRENCY=10
ACTIVE_STORAGE_SERVICE=local
# Defaults to true (force HTTPS). Works fine behind Traefik/Dokploy's proxy
# (forwards X-Forwarded-Proto). Set to false only if TLS terminates externally
# without that header, or the app is reached over plain HTTP.
FORCE_SSL=true
# Para usar S3/R2/MinIO externo, troque para s3_compatible e preencha abaixo.
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_BUCKET_NAME=
# STORAGE_ENDPOINT=https://xxxx.r2.cloudflarestorage.com

# CRM
DISABLE_TELEMETRY=true
LOG_LEVEL=info
ENABLE_ACCOUNT_SIGNUP=true
ENABLE_PUSH_RELAY_SERVER=true
ENABLE_INBOX_EVENTS=true
EVO_FLOW_ENABLED=true

# Core
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
JWT_ALGORITHM=HS256
AI_PROCESSOR_VERSION=v1
# Only "true" grants permissions when evo-auth answers 404 on the permission
# endpoint (a transitional deploy where auth isn't upgraded yet); outages,
# 401/403/5xx always deny.
EVO_AUTH_ALLOW_MISSING_PERMISSION_ENDPOINT=false

# Processor
REDIS_DB=0
REDIS_KEY_PREFIX=a2a:
REDIS_TTL=3600
HOST=0.0.0.0
PROCESSOR_PORT=8000
DEBUG=false
API_TITLE=Agent Processor Community
API_DESCRIPTION=Agent Processor Community for Evo AI
API_VERSION=1.0.0
ORGANIZATION_NAME=AutomaLead
TOOLS_CACHE_ENABLED=true
TOOLS_CACHE_TTL=3600

# Bot runtime
AI_CALL_TIMEOUT_SECONDS=90

# Host(s) serving incoming media to the AI agent, comma-separated, no scheme/port.
# Must match the host of BACKEND_URL (that host signs the attachment URLs);
# without it the agent receives no media.
MEDIA_HOST_ALLOWLIST=

# ── Evolution API ─────────────────────────────────────────
EVOLUTION_PUBLIC_URL=https://evolution.maliza.dokploy.bellosoft.dev
EVOLUTION_API_KEY=EvolutionP55word123
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO,WEBHOOKS,WEBSOCKET
EVOLUTION_LANGUAGE=pt-BR

# ── n8n ───────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=e3fa5d6dfb23458d4a3c007a8845db28
N8N_HOST=n8n.maliza.dokploy.bellosoft.dev
N8N_WEBHOOK_URL=https://n8n.maliza.dokploy.bellosoft.dev
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8nP55word123
TIMEZONE=America/Sao_Paulo
